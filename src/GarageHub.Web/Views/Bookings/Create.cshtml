@model GarageHub.Common.Dtos.Booking.BookingInputDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Book a schedule";
}

<h1>Book a schedule</h1>
<p>A 10,000 VND deposit is charged at checkout. Your slot is held for 15 minutes while payment is pending.</p>
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@if (!ViewBag.HasVehicles)
{
    <div class="alert alert-warning">
        Add a vehicle before booking. <a asp-controller="Vehicles" asp-action="Create">Add vehicle</a>
    </div>
}
@if (!ViewBag.HasGarages)
{
    <div class="alert alert-warning">There are no garages available for booking yet.</div>
}
<form method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
    <div class="mb-3">
        @Html.LabelFor(model => model.VehicleId, "Vehicle", new { @class = "form-label" })
        @Html.DropDownListFor(model => model.VehicleId,
            (IEnumerable<SelectListItem>)ViewBag.Vehicles,
            "Select a vehicle",
            new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.VehicleId, "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <button type="button" class="btn btn-outline-secondary" id="scan-vehicle-button">
            Scan license plate from image
        </button>
        <input type="file" id="vehicle-image" accept="image/*" class="d-none" />
        <div id="scan-message" class="form-text" role="status" aria-live="polite"></div>
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.GarageId, "Garage", new { @class = "form-label" })
        @Html.DropDownListFor(model => model.GarageId,
            (IEnumerable<SelectListItem>)ViewBag.Garages,
            "Select a garage",
            new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.GarageId, "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.ScheduledDate, "Date", new { @class = "form-label" })
        @Html.TextBoxFor(model => model.ScheduledDate,
            new { type = "date", min = ViewBag.MinimumDate, @class = "form-control" })
        @Html.ValidationMessageFor(model => model.ScheduledDate, "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.SlotStart, "Time slot", new { @class = "form-label" })
        @Html.DropDownListFor(model => model.SlotStart,
            (IEnumerable<SelectListItem>)ViewBag.Slots,
            "Select a time slot",
            new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.SlotStart, "", new { @class = "text-danger" })
    </div>
    @if (ViewBag.HasVehicles && ViewBag.HasGarages)
    {
        <button type="submit" class="btn btn-primary">Continue to checkout</button>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const scanButton = document.getElementById("scan-vehicle-button");
        const imageInput = document.getElementById("vehicle-image");
        const scanMessage = document.getElementById("scan-message");
        const vehicleSelect = document.getElementById("VehicleId");

        scanButton.addEventListener("click", function () {
            imageInput.click();
        });

        imageInput.addEventListener("change", async function () {
            const image = this.files[0];
            if (!image) {
                return;
            }

            const formData = new FormData();
            formData.append("image", image);
            scanButton.disabled = true;
            scanMessage.textContent = "Scanning license plate...";

            try {
                const response = await fetch("/api/ocr/scan-plate", {
                    method: "POST",
                    headers: { "Accept": "application/json" },
                    body: formData
                });
                const result = await response.json();
                if (!response.ok) {
                    throw new Error(result.message || "Plate scanning failed. Please try again.");
                }

                if (!result.plateNumber) {
                    scanMessage.textContent = "No license plate was detected. Try a clearer image.";
                    return;
                }

                const normalizedPlate = result.plateNumber.replace(/[^a-z0-9]/gi, "").toUpperCase();
                const matchingVehicle = Array.from(vehicleSelect.options).find(option => {
                    const optionPlate = option.text.split(" - ")[0]
                        .replace(/[^a-z0-9]/gi, "").toUpperCase();
                    return option.value && optionPlate === normalizedPlate;
                });

                if (matchingVehicle) {
                    vehicleSelect.value = matchingVehicle.value;
                    scanMessage.textContent = `Detected ${result.plateNumber}; your vehicle was selected.`;
                } else {
                    scanMessage.textContent = result.vehicleFound
                        ? `Detected ${result.plateNumber}, but it is not in your vehicle list. Add it before booking.`
                        : `Detected ${result.plateNumber}, but it is not in your vehicle list.`;
                }
            } catch (error) {
                scanMessage.textContent = error.message || "Plate scanning failed. Please try again.";
            } finally {
                scanButton.disabled = false;
                imageInput.value = "";
            }
        });
    </script>
}
