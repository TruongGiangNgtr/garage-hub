@using GarageHub.Common.Dtos.Booking
@using GarageHub.Common.Enums
@{
    ViewData["Title"] = "Home";
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="text-end mb-3">
    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Login">Admin Functions</a>
</div>

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="text-center">
        <h1 class="display-4">Welcome to GarageHub</h1>
        <p>Book and manage vehicle service appointments.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="GoogleLogin">Login with Google</a>
    </div>
}
else
{
    var bookings = ViewBag.Bookings as IReadOnlyList<BookingScheduleDto> ?? Array.Empty<BookingScheduleDto>();
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Welcome, @User.Identity.Name</h1>
            <p class="mb-0">Your service schedule</p>
        </div>
        <a class="btn btn-primary" asp-controller="Bookings" asp-action="Create">Add booking</a>
    </div>

    @if (bookings.Count == 0)
    {
        <div class="alert alert-info">You don't have any bookings yet.</div>
    }
    else
    {
        <div class="mb-3">
            <label for="booking-status-filter" class="form-label">Filter by status</label>
            <select id="booking-status-filter" class="form-select" style="max-width: 20rem">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<BookingStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Actions</th>
                    <th>Date and time</th>
                    <th>Vehicle</th>
                    <th>Garage</th>
                    <th>Status</th>
                    <th>Deposit</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var booking in bookings)
            {
                <tr data-booking-status="@booking.Status">
                    <td class="text-nowrap">
                        <div class="d-flex flex-wrap gap-2">
                            @if (booking.Status == BookingStatus.Pending)
                            {
                                <form asp-controller="Booking" asp-action="PayNow" asp-route-id="@booking.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-primary">Pay Now</button>
                                </form>
                                <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@booking.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel Booking</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-primary" disabled>Pay Now</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled>Cancel Booking</button>
                            }
                        </div>
                    </td>
                    <td>@booking.ScheduledAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@booking.PlateNumber</td>
                    <td>@booking.GarageName</td>
                    <td>@booking.Status</td>
                    <td>@booking.DepositAmount.ToString("N0") VND</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <p id="no-bookings-for-status" class="alert alert-info d-none">No bookings match this status.</p>

        @section Scripts {
            <script>
                document.getElementById("booking-status-filter")?.addEventListener("change", function () {
                    const selectedStatus = this.value;
                    const rows = document.querySelectorAll("[data-booking-status]");
                    let visibleCount = 0;

                    rows.forEach(row => {
                        const isVisible = !selectedStatus || row.dataset.bookingStatus === selectedStatus;
                        row.hidden = !isVisible;
                        if (isVisible) {
                            visibleCount++;
                        }
                    });

                    document.getElementById("no-bookings-for-status").classList.toggle("d-none", visibleCount > 0);
                });
            </script>
        }
    }
}
