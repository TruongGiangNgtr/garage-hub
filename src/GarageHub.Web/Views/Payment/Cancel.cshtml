@model GarageHub.Common.Dtos.Payment.PaymentResultDto
@{ ViewData["Title"] = "Hủy thanh toán"; }
@using GarageHub.Common.Enums
@{
    var bookingPending = Model.BookingStatus == BookingStatus.Pending;
}
@if (bookingPending)
{
    <h2>Thanh toán chưa hoàn tất</h2>
    <p>Lịch hẹn vẫn được giữ đến khi hết hạn. Bạn có thể thanh toán lại hoặc hủy lịch hẹn.</p>
}
else if (Model.PaymentStatus == PaymentStatus.Canceled)
{
    <h2>Bạn đã hủy thanh toán, chỗ giữ đã được nhả</h2>
}
else if (Model.PaymentStatus == PaymentStatus.Confirmed && Model.BookingStatus == BookingStatus.Confirmed)
{
    <h2>Đặt cọc thành công</h2>
}
else if (Model.PaymentStatus == PaymentStatus.Pending)
{
    <meta http-equiv="refresh" content="5" />
    <h2>Đang xử lý</h2>
    <p>Hệ thống đang chờ xác nhận thanh toán, trang sẽ tự tải lại.</p>
}
else if (Model.PaymentStatus == PaymentStatus.Confirmed)
{
    <h2>Đã nhận thanh toán</h2>
    <p>Lịch hẹn không còn hiệu lực, nhân viên garage sẽ liên hệ bạn.</p>
}
else
{
    <h2>Thanh toán không thành công hoặc đã hết hạn</h2>
}
<p>Số tiền: @Model.Amount.ToString("N0") đ</p>
<div class="d-flex flex-wrap gap-2 mb-3">
    @if (bookingPending)
    {
        <form asp-controller="Booking" asp-action="PayNow" asp-route-id="@Model.BookingId" method="post">
            <button type="submit" class="btn btn-primary">Pay Now</button>
        </form>
        <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@Model.BookingId" method="post">
            <button type="submit" class="btn btn-outline-danger">Cancel Booking</button>
        </form>
    }
    else
    {
        <button type="button" class="btn btn-primary" disabled>Pay Now</button>
        <button type="button" class="btn btn-outline-danger" disabled>Cancel Booking</button>
    }
    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Back to Home</a>
</div>
