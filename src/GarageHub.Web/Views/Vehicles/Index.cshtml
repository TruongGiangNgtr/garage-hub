@model IReadOnlyList<GarageHub.Common.Dtos.Vehicle.VehicleDto>
@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Vehicles</h1>
    <a class="btn btn-primary" asp-action="Create">Add vehicle</a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Plate number</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Owner</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var vehicle in Model)
    {
        <tr>
            <td>@vehicle.PlateNumber</td>
            <td>@vehicle.Brand</td>
            <td>@vehicle.Model</td>
            <td>@vehicle.OwnerName</td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@vehicle.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@vehicle.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this vehicle?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
